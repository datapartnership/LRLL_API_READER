# Example: configure via .env and override in code
DDPLRLL_API_BASE_URL=http://localhost:5000
DDPLRLL_OUTPUT_DIR=./output
DDPLRLL_LIMIT=30

# Microsoft Entra ID public desktop app and delegated permission for the API.
# Register http://localhost under Mobile and desktop applications.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_SCOPE=api://YOUR_API_APP_ID/access_as_user
ENTRA_CALLBACK_PORT=8081

# Optional browser-based SPA sign-in (no desktop redirect registration needed).
# This exact URI must be registered under Single-page application.
# Stop any dev server using port 5173 before starting sign-in.
ENTRA_SPA_REDIRECT_URI=http://localhost:5173/callback
ENTRA_SPA_TIMEOUT_SECONDS=300
