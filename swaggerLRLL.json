{
  "openapi": "3.0.1",
  "info": {
    "title": "Low Resource Language Library API",
    "description": "Query the Low Resource Language Library catalogue and receive\n**Croissant 1.0 JSON-LD** responses ready for ML dataset tooling.\n\nAll endpoints (except `/health`) require authentication via Azure AD.\nClick **Authorize** to sign in — a browser pop-up will guide you through\nthe OAuth 2.0 Authorization Code flow and return a token automatically.",
    "contact": {
      "name": "DDP Data Access",
      "url": "https://datapartnership.org/contact",
      "email": "data@datapartnership.org"
    },
    "version": "v1"
  },
  "paths": {
    "/api/Datasets/query": {
      "get": {
        "tags": [
          "Datasets"
        ],
        "summary": "Query files and receive a Croissant JSON-LD response.",
        "description": "All filter parameters are optional and combinable.\r\nWhen the number of matching files exceeds **limit**, the API randomly\r\nsamples **limit** files from the full result set.\r\n            \r\n**Authentication**: supply your API key in the `X-Api-Key` header\r\n(or use the Authorize button in Swagger UI).\r\n            \r\n### Example\r\n    GET /api/datasets/query?keyword=malaria&year=2024&limit=10",
        "parameters": [
          {
            "name": "Keyword",
            "in": "query",
            "description": "Filter by keyword (partial, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Theme",
            "in": "query",
            "description": "Filter by theme (partial, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Author",
            "in": "query",
            "description": "Filter by author name (partial, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Year",
            "in": "query",
            "description": "Filter by publication year, e.g. 2024",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Limit",
            "in": "query",
            "description": "Maximum number of file entries returned in the JSON-LD output.\r\nWhen more files match than the limit, a random sample is taken.\r\nDefault: 30. Max: 100.",
