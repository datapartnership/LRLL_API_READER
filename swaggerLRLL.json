    "/api/sound/files/{id}": {
      "get": {
        "tags": [
          "SoundFiles"
        ],
        "summary": "Download an audio file by its sound file record ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique sound file record identifier.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The audio file stream",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Sound file record not found or file missing on storage",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "nullable": true,
            "example": "Unauthorized"
          },
          "detail": {
            "type": "string",
            "nullable": true,
            "example": "Missing 'X-Api-Key' header."
          }
        },
        "additionalProperties": false,
        "description": "Authentication/authorisation error response."
      },
      "CroissantResponse": {
        "type": "object",
        "properties": {
          "context": {
            "type": "array",
            "items": { },
            "description": "JSON-LD context array",
            "nullable": true,
            "example": [
              "https://mlcommons.org/working-groups/data/croissant/"
            ]
          },
          "generatedAt": {
            "type": "string",
            "description": "UTC timestamp when the response was generated",
            "nullable": true,
            "example": "2026-03-02T12:00:00.0000000Z"
