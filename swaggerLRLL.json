    "/api/Datasets/health": {
      "get": {
        "tags": [
          "Datasets"
        ],
        "summary": "Health check — returns API status and database file count.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Files/{id}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Download a file's content as shuffled paragraphs.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique file record identifier, e.g. `file-2024-001005c4`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file content with paragraphs in randomised order"
          },
          "404": {
            "description": "File record not found or file missing on storage",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Daily download limit reached",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Seed": {
      "post": {
        "tags": [
          "Seed"
        ],
        "summary": "Scan storage (or generate dummy data) and seed the database.",
        "description": "Two modes are supported:\r\n            \r\n**Scan** (default) — walks the configured storage root.  Each top-level\r\ndirectory becomes a Dataset; all PDF/TXT files beneath it are inserted as\r\nFileRecords with random UNBIS themes and keywords.  Already-present records\r\n(matched by `ContentUrl`) are skipped, so the operation is idempotent.\r\n            \r\n**Dummy** — generates synthetic records without touching the file storage.\r\nUseful for local development when no real files exist.\r\n            \r\n**Authentication**: supply your API key in the `X-Api-Key` header.\r\n            \r\n### Scan example\r\n    POST /api/seed\r\n    { \"mode\": \"Scan\" }\r\n            \r\n### Dummy example\r\n    POST /api/seed\r\n    { \"mode\": \"Dummy\", \"dummyHouses\": \"MediaHouseA,MediaHouseB\", \"dummyFilesPerHouse\": 20 }",
        "requestBody": {
          "description": "Seed options",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SeedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seed completed — returns a summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Seed/sound": {
      "post": {
        "tags": [
          "Seed"
        ],
        "summary": "Scan the sound storage bucket for `*_metadata.jsonld` files and seed the database\r\nwith LlrpApi.DTOs.SoundSeedResult entities.",
        "description": "Walks every `*_metadata.jsonld` file found in the configured sound bucket/container,\r\nparses the Croissant JSON-LD, and upserts `SoundDataset` + `SoundFileRecord` rows.\r\nAlready-present records (matched by `ContentUrl`) are skipped — the operation is idempotent.\r\n            \r\n### Example\r\n    POST /api/seed/sound",
        "responses": {
          "200": {
            "description": "Sound seed completed — returns a summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoundSeedResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Seed/reset-db": {
      "post": {
        "tags": [
          "Seed"
        ],
        "summary": "Reset API-managed metadata tables by deleting all rows.",
        "description": "This operation is destructive and intended for development or controlled admin use.\r\nIt deletes data from LRLL API-owned tables only and leaves external/shared tables intact.\r\n            \r\nTo execute, pass `?confirm=true`.\r\n            \r\n### Example\r\n    POST /api/seed/reset-db?confirm=true",
        "parameters": [
          {
            "name": "confirm",
            "in": "query",
            "description": "Must be `true` to execute.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Database tables were reset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetDbResult"
                }
              }
            }
          },
          "400": {
            "description": "Missing confirmation flag",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Seed/recreate-schema": {
      "post": {
        "tags": [
          "Seed"
        ],
        "summary": "Drop all tables and recreate the EF Core schema via migrations.",
        "description": "This operation is highly destructive and intended for local development/testing only.\r\nIt drops all tables in the active schema (PostgreSQL) and then recreates EF-managed tables.\r\n            \r\nTo execute, pass `?confirm=true`.\r\n            \r\n### Example\r\n    POST /api/seed/recreate-schema?confirm=true",
        "parameters": [
          {
            "name": "confirm",
            "in": "query",
            "description": "Must be `true` to execute.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schema recreated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecreateSchemaResult"
                }
              }
            }
          },
          "400": {
            "description": "Missing confirmation flag",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sound/query": {
      "get": {
        "tags": [
          "SoundDatasets"
        ],
        "summary": "Query sound datasets and receive a Croissant 1.0 JSON-LD document.",
        "description": "Returns audio file metadata grouped by programme/dataset.\r\nWhen more files match than p.`Limit`, a random sample is returned.\r\n            \r\n### Example\r\n    GET /api/sound/query?language=ny&limit=20",
        "parameters": [
          {
            "name": "Language",
            "in": "query",
            "description": "Filter by subject language code or display language identifier (partial, case-insensitive), e.g. `ny` or `en-GB`",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Programme",
            "in": "query",
            "description": "Filter by programme / dataset name (partial, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Keyword",
            "in": "query",
            "description": "Filter by keyword stored on the dataset (partial, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Year",
            "in": "query",
            "description": "Filter by year appearing in datePublished or temporalCoverage, e.g. 2025",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Limit",
            "in": "query",
            "description": "Maximum number of audio file entries returned in the JSON-LD output.\r\nWhen more files match than the limit, a random sample is taken.\r\nDefault: 30. Max: 100.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Croissant 1.0 JSON-LD document"
          },
          "400": {
            "description": "Invalid limit value",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sound/health": {
      "get": {
        "tags": [
